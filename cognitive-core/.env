# Cognitive Core Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ultron_cognitive_2026
REDIS_HOST=localhost
REDIS_PORT=6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Mode Configuration
# true = Usa servicios Docker (Qdrant + Neo4j)
# false = Modo demo sin Docker
USE_DOCKER_SERVICES=true

# Embeddings (Ollama unificado)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Ollama (Cortex LLM local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=dolphin-phi:2.7b-v2.6-q4_K_M

# Theological Configuration
THEOLOGICAL_MODE=true
MAX_TOT_DEPTH=3
TOT_BRANCHING_FACTOR=3
DOCTRINAL_FIDELITY_THRESHOLD=0.7
PERSUASIVE_EFFECTIVENESS_THRESHOLD=0.6

# IA 100% LOCAL - Sin APIs externas
# Solo usamos Ollama local para embeddings y LLM